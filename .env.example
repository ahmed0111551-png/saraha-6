PORT=3000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/anonymous-messaging
CLIENT_URL=http://localhost:5173

# Use long random strings (e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too

# Optional in development (emails/OTP are printed in the console), required in production
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Anonymous Messaging <no-reply@example.com>"
